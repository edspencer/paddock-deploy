# Managed by Ansible — do not edit by hand.
# Base (non-secret) environment for the Paddock instance.
# Secrets live alongside this in paddock.secret.env (mode 0600).

{% if paddock_deploy_method == 'docker' %}
# Docker method: the app runs INSIDE a container, so it must bind 0.0.0.0 —
# a 127.0.0.1 bind would be the container's own loopback and the systemd unit's
# `-p {{ paddock_bind_host }}:{{ paddock_port }}:{{ paddock_port }}` host publish
# could not route to it. The host publish stays loopback-only, so that (not the
# in-container bind) is the security boundary; acknowledge Paddock's fail-closed
# guard accordingly. Front it with an edge proxy / auth sidecar.
HOST=0.0.0.0
PADDOCK_DANGEROUSLY_ALLOW_OPEN=1
{% else %}
# Tarball/native method: bind loopback and authenticate at the edge (reverse
# proxy / sidecar) — the process is reachable on the box's loopback.
HOST={{ paddock_bind_host }}
{% endif %}
PORT={{ paddock_port }}

# Data volume: projects, chat history, and the instance-wide CLAUDE.md.
PADDOCK_DATA_DIR={{ paddock_data_dir }}

# Box role, for your own reference / conditional config.
PADDOCK_BOX_TYPE={{ paddock_box_type }}

# Auth mode is provider-agnostic: none | trusted-header | jwt.
# Keep this in the SECRET env file if it references issuer URLs/keys.
# PADDOCK_AUTH_MODE=trusted-header
