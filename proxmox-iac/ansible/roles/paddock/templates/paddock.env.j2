# Managed by Ansible — do not edit by hand.
# Base (non-secret) environment for the Paddock instance.
# Secrets live alongside this in paddock.secret.env (mode 0600).

# Bind loopback by default; authenticate at the edge (reverse proxy / sidecar).
HOST={{ paddock_bind_host }}
PORT={{ paddock_port }}

# Data volume: projects, chat history, and the instance-wide CLAUDE.md.
PADDOCK_DATA_DIR={{ paddock_data_dir }}

# Box role, for your own reference / conditional config.
PADDOCK_BOX_TYPE={{ paddock_box_type }}

# Auth mode is provider-agnostic: none | trusted-header | jwt.
# Keep this in the SECRET env file if it references issuer URLs/keys.
# PADDOCK_AUTH_MODE=trusted-header
