# Caddy Basic-Auth sidecar for Paddock.
#
# SITE_ADDRESS controls the site (and thus TLS):
#   - "localhost" (default)  -> Caddy serves HTTPS with its own internal CA
#                               (self-signed; use `curl -k` or trust the CA).
#   - "paddock.example.com"  -> a real hostname makes Caddy provision a public
#                               Let's Encrypt certificate automatically. Delete
#                               the `tls internal` line below when you do that.
{$SITE_ADDRESS:localhost} {
	# Local development default: self-signed cert from Caddy's internal CA.
	# Remove this line for a real public hostname (automatic HTTPS via ACME).
	tls internal

	# ── Paddock's Management API (`/mcp`) ────────────────────────────────────
	# Basic Auth and MCP collide head-on: this proxy challenges with the
	# `Authorization` header, and an MCP client puts its own
	# `Authorization: Bearer <token>` there. The proxy reads that bearer token as
	# malformed Basic credentials and 401s, so an MCP client can NEVER reach
	# Paddock through a blanket `basic_auth`. Hence the exemption below.
	#
	# The exempt paths are still authenticated — by PADDOCK, not by this proxy.
	# `/mcp` runs its own per-client token authenticator, independent of
	# PADDOCK_AUTH_MODE and of this sidecar, and it fails CLOSED: 404 when no
	# management clients are configured, 401 + `WWW-Authenticate` when the
	# credential is missing or wrong. A proxy is never what gates it.
	#
	#   !! DEPLOY ORDER !! Only apply this exemption once you are running a
	#   Paddock that authenticates `/mcp` (v0.46.0 or newer). On an older build
	#   `/mcp` is not gated by anything, so exempting it here would publish an
	#   unauthenticated, TURN-SPAWNING endpoint — and a keeper has a shell, so
	#   any write scope on it is remote code execution on this host. Upgrade
	#   Paddock first, confirm `/mcp` 404s or 401s on its own, then exempt.
	#
	# `/.well-known/oauth-protected-resource` (and its path-inserted form
	# `…/oauth-protected-resource/mcp`, which is the one clients actually
	# request) is exempt too. It is RFC 9728 discovery metadata, fetched BEFORE
	# the client holds any credential — gating it makes discovery impossible,
	# and a client that gets HTML or a Basic challenge there silently falls
	# through to treating Paddock as its own authorization server, with no error
	# naming the cause.
	@management {
		path /mcp /mcp/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	}

	handle @management {
		reverse_proxy paddock:4000 {
			# No Basic Auth ran, so there is no authenticated identity to assert.
			# DELETE the header rather than leave it: without this, a client could
			# send its own `X-Forwarded-User` on this un-challenged path and have
			# it forwarded verbatim. (Paddock ignores the browser identity on
			# `/mcp` — the caller is the management client — but the invariant
			# "this proxy is the only source of X-Forwarded-User" should hold on
			# every route, not just the challenged ones.)
			header_up -X-Forwarded-User
		}
	}

	# ── Everything else: the browser UI, gated by Basic Auth ─────────────────
	handle {
		# HTTP Basic Auth. Generate a bcrypt hash ($$-escaped for Compose) with:
		#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password' | sed 's/\$/\$\$/g'
		# then put the username + hash in caddy.env (see caddy.env.example).
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
		}

		reverse_proxy paddock:4000 {
			# Overwrite (never pass through) the identity header, setting it from
			# the authenticated Basic Auth user. `header_up X-Forwarded-User …`
			# REPLACES any client-supplied value, so the header cannot be forged.
			header_up X-Forwarded-User {http.auth.user.id}
		}
	}
}
