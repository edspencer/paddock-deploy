# Caddy proxy credentials + site address.
# Copy to `caddy.env` (gitignored) and fill in real values. NEVER commit real
# credentials or hashes.

# The site address Caddy serves. "localhost" gives a self-signed internal cert
# for local testing; a real hostname (e.g. paddock.example.com) makes Caddy
# provision a public Let's Encrypt certificate automatically — see Caddyfile.
SITE_ADDRESS=localhost

# The Basic Auth username.
BASIC_AUTH_USER=admin

# The Basic Auth password as a BCRYPT HASH (not the plaintext password).
# Generate one — and DOUBLE every "$" to "$$" so Docker Compose doesn't treat
# the hash as variable references (a bcrypt hash is full of "$"; current Compose
# interpolates env_file values and would silently truncate it):
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password' | sed 's/\$/\$\$/g'
# The value below is the password "changeme", already $$-escaped — replace it.
BASIC_AUTH_HASH=$$2a$$14$$Zt1eJ8mS1p3o5r7t9v1x0uJ8mS1p3o5r7t9v1x0uJ8mS1p3o5r7t
